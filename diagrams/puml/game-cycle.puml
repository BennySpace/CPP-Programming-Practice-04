@startuml
title Игровой цикл
skinparam shadowing false
start

:Загрузить savegame.json\nили создать начальный профиль;

repeat
  :Открыть один из разделов;
  if (Race Hub?) then (да)
    :Выбрать Monaco, Spa или Monza;
    if (Есть кредиты на взнос\nи хотя бы 1 топливо?) then (да)
      :Списать entry fee;
      :Применить событие трассы\n(штраф / расход топлива / потеря loot);
      while (Игрок продолжает заезд?) is (да)
        :Выбрать Aero Wing, High Power\nили Wet Grip;
        if (Мод исправен?) then (да)
          :Потратить 1 топливо;
          :Случайно износить мод;
          if (Найдена добыча?) then (да)
            :Добавить предмет в инвентарь;
          endif
        else (нет)
          :Показать отказ в заезде;
        endif
        :Автосохранение;
      endwhile (нет)
      :Покинуть гонку;
    else (нет)
      :Показать, чего не хватает;
    endif
  elseif (Garage?) then (да)
    if (Купить топливо?) then (да)
      :Списать кредиты;
      :Добавить fuel pack;
    elseif (Ремонтировать мод?) then (да)
      :Списать кредиты;
      :Восстановить durability;
    else (Продать loot)
      :Удалить loot;
      :Добавить его стоимость к кредитам;
    endif
    :Автосохранение при успехе;
  else (Museum)
    :Выбрать loot для экспозиции;
    :Переместить предмет\nиз inventory в museum;
    :Выдать награду за новый milestone;
    :Автосохранение при успехе;
  endif
repeat while (Окно игры открыто?) is (да)

:Сохранить прогресс и закрыть окно;
stop
@enduml
